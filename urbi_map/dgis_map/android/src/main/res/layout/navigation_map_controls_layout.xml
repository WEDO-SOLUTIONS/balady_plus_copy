<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:theme="@style/DGisTheme.Navigation">

    <ru.dgis.sdk.navigation.ZoomControl
        android:id="@+id/dgisNavigatorZoomControl"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@id/dgisNavigatorAddEventButton"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed" />

    <ImageButton
        android:id="@+id/dgisNavigatorAddEventButton"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginHorizontal="4dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="4dp"
        android:background="@drawable/dgis_navigator_map_control_button_group_background"
        android:elevation="4dp"
        android:src="@drawable/dgis_navi_ic_tugc_hollow"
        android:theme="?dgis_mapControlsStyle"
        app:layout_constraintBottom_toTopOf="@id/dgisNavigatorCompassControl"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/dgisNavigatorZoomControl"
        tools:ignore="ContentDescription" />

    <ru.dgis.sdk.navigation.CompassControl
        android:id="@+id/dgisNavigatorCompassControl"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@id/dgisNavigatorFollowControl"
        app:layout_constraintLeft_toLeftOf="@+id/dgisNavigatorFollowControl"
        app:layout_constraintRight_toRightOf="@+id/dgisNavigatorFollowControl" />

    <ru.dgis.sdk.navigation.FollowControl
        android:id="@+id/dgisNavigatorFollowControl"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
