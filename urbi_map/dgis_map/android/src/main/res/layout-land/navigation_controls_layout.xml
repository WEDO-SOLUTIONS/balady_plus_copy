<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:theme="@style/DGisTheme.Navigation">

    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageButton
            android:id="@+id/dgisNavigatorShowDashboardButton"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_margin="8dp"
            android:background="@drawable/dgis_round_button_background_16dp"
            android:elevation="4dp"
            android:src="@drawable/dgis_navi_ic_show_more"
            android:theme="?dgis_mapControlsStyle"
            app:tint="?dgis_buttonIconColor"
            android:visibility="gone"
            tools:ignore="ContentDescription"
            tools:visibility="visible" />
    </FrameLayout>

    <ru.dgis.sdk.navigation.MessageControl
        android:id="@+id/messageControl"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ru.dgis.sdk.navigation.ManeuverControl
        android:id="@+id/maneuverControl"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ru.dgis.sdk.navigation.SpeedInfoControl
        android:id="@+id/speedInfoControl"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="54dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ru.dgis.sdk.navigation.BetterRoutePromptControl
        android:id="@+id/betterRoutePromptControl"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintWidth_default="percent"
        app:layout_constraintWidth_percent="0.5" />

    <ru.dgis.sdk.navigation.TrafficLineControl
        android:id="@+id/dgisNavigatorTrafficLineControl"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="4dp"
        android:layout_marginBottom="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:visibility="gone" />

    <ru.dgis.sdk.map.MarkedByRouteIndoorControl
        android:id="@+id/dgisNavigatorIndoorControl"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginBottom="76dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:background="?dgis_surfaceColor"
        tools:layout_height="200dp"
        tools:layout_width="48dp"
        tools:visibility="gone" />

    <com.dgis.map.views.MapControls
        android:id="@+id/mapnessNavigatorMapControls"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="4dp" />

    <ru.dgis.sdk.map.MapPaddingControl
        android:id="@+id/dgisNavigatorMapPaddingControl"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="68dp" />

    <ru.dgis.sdk.navigation.ShowRouteControl
        android:id="@+id/dgisNavigatorShowRouteControl"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="186dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="162dp"
        android:layout_marginBottom="78dp" />

    <View
        android:id="@+id/dgisNavigatorDashboardFade"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="?dgis_fadeColor"
        android:theme="?dgis_dashboardControlStyle"
        android:visibility="gone" />

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintWidth_default="percent"
        app:layout_constraintWidth_percent="0.5">

        <ru.dgis.sdk.navigation.DashboardControl
            android:id="@+id/dgisNavigatorDashboardControl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:behavior_hideable="false"
            app:behavior_peekHeight="76dp"
            app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior" />
    </androidx.coordinatorlayout.widget.CoordinatorLayout>


    <ru.dgis.sdk.navigation.FinishRouteControl
        android:id="@+id/dgisNavigatorFinishRouteControl"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintWidth_default="percent"
        app:layout_constraintWidth_percent="0.5" />

    <ru.dgis.sdk.navigation.AddRoadEventControls
        android:id="@+id/dgisNavigatorAddRoadEventControls"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ru.dgis.sdk.navigation.RouteOverviewControl
        android:id="@+id/dgisNavigatorRouteOverviewControl"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintWidth_default="percent"
        app:layout_constraintWidth_percent="0.5" />

</androidx.constraintlayout.widget.ConstraintLayout>
