# Spec sources. The ByteDance / VolcEngine repos host the RangersAppLog
# (BytePlus DataFinder) XCFramework, which is not on the public CocoaPods CDN.
source 'https://cdn.cocoapods.org'
source 'https://github.com/bytedance/cocoapods_sdk_source_repo.git'
source 'https://github.com/volcengine/volcengine-specs.git'

# Uncomment this line to define a global platform for your project
platform :ios, '16.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end

  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!
  use_modular_headers!
  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  pod 'InsiderMobile'
  pod 'InsiderHybrid'

  # BytePlus RangersAppLog — XCFramework build.
  # This version contains both device (arm64) and simulator (arm64-simulator)
  # slices, so it works on the iOS Simulator (stg/dev) and real devices
  # (pre/prod) from a single pod install. Pinning it here (instead of letting
  # the Flutter plugin pull RangersAppLog/Core >= 5.6.3 from the CDN) is required
  # because the XCFramework build only exists in the ByteDance/VolcEngine specs.
  pod 'RangersAppLog', '6.17.7-iOS26-xc-rc2',
      :subspecs => ['Core', 'Host', 'Log', 'UITracker']
end

post_install do |installer|
    installer.generated_projects.each do |project| # تأكد من المرور على كل المشاريع المولدة
        project.targets.each do |target|
          target.build_configurations.each do |config|
            config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '16.0'
          end
        end
      end
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '16'
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] ||= [
        '$(inherited)',
        'PERMISSION_CAMERA=1',
        'PERMISSION_PHOTOS=1',
        'PERMISSION_LOCATION=1',
        'PERMISSION_NOTIFICATIONS=1',
        'PERMISSION_MEDIA_LIBRARY=1',
      ]
    end

    # rename conflicting thermal bundles
    case target.name
    when 'wakelock_plus-thermal'
      target.build_configurations.each do |config|
        config.build_settings['PRODUCT_NAME'] = 'wakelock_plus_thermal'
      end
    when 'thermal-thermal'
      target.build_configurations.each do |config|
        config.build_settings['PRODUCT_NAME'] = 'thermal_thermal'
      end
    end
  end
end

target 'InsiderNotificationContent' do
  platform :ios, '16.0' # أضف هذا السطر هنا
  use_frameworks!
  inherit! :search_paths
  pod "InsiderMobileAdvancedNotification"
end

target 'InsiderNotificationService' do
  platform :ios, '16.0' # وأيضاً هنا
  use_frameworks!
  inherit! :search_paths
  pod "InsiderMobileAdvancedNotification"
end
