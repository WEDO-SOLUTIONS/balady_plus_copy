# Uncomment the line if you want fastlane to automatically update itself
# update_fastlane

default_platform(:ios)

platform :ios do
  desc "Push a new Staging build to TestFlight"
  lane :stg do
    increment_build_number(xcodeproj: "Runner.xcodeproj")
    build_app(workspace: "Runner.xcworkspace", scheme: "stg")
    upload_to_testflight(
        groups: ["QA", "Staging",] ,
#         skip_waiting_for_build_processing: true,
#         app_version: "2.30.2",
#         build_number: "372",
#         notify_external_testers: ,
#         distribute_external:  ,
    )
  end
   desc "Push a new PreProduction build to TestFlight"
    lane :pre do
      increment_build_number(xcodeproj: "Runner.xcodeproj")
      build_app(workspace: "Runner.xcworkspace", scheme: "pre")
      upload_to_testflight(
          groups: ["preProduction"] ,
#         skip_waiting_for_build_processing: true,
#         app_version: "2.30.2",
#         build_number: "372",
#         notify_external_testers: ,
#         distribute_external:  ,
      )
    end
end

