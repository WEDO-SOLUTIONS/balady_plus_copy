default:
    just --list

# define shell envs

export PATH := env_var('PATH') + ":" + absolute_path('mapness/scripts/common_functions')
export GIT_BRANCH := `git rev-parse --abbrev-ref HEAD`
export GIT_COMMIT := replace_regex(`git rev-parse HEAD`, '([a-zA-Z0-9]{8}).*', '$1') + ' ' + `git --no-pager show -s --format='%s'`
export VENDOR_CONFIG := env_var_or_default('VENDOR_CONFIG', 'unknown')
dart_define := "--dart-define=GIT_BRANCH=\"" + GIT_BRANCH + "\" --dart-define=GIT_COMMIT=\"" + GIT_COMMIT + "\" --dart-define=VENDOR_CONFIG=$VENDOR_CONFIG"

prebuild: pubget codegen

dev-env-setup:
    #!/bin/bash
    set -euo pipefail
    lefthook install
    echo "Please, refer to https://github.com:urbi-ae/baladi/urbi/mapness/scripts/dev-env-setup.sh as a main setup script..."
    sleep 3

codegen:
    #!/bin/bash
    set -euo pipefail
    fvm dart run build_runner build --delete-conflicting-outputs || true

codegen_cached:
    #!/bin/bash
    set -euo pipefail
    echo '> generate code...'
    fvm dart run cached_build_runner build || true
    echo '< code generated'

pubget:
    #!/bin/bash
    set -euo pipefail
    fvm flutter pub get

run_widgetbook:
    #!/bin/bash
    cd example
    set -euo pipefail
    fvm flutter run -d chrome

color_gen:
    fvm dart run color_generator/lib/main.dart