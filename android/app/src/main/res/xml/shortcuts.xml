<?xml version="1.0" encoding="utf-8"?>
<!--
  Static shortcuts — visible on the home-screen icon as soon as the app is installed
  (before first launch). Keys must match quick_actions / app config shortcut keys.
-->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="favorites"
        android:enabled="true"
        android:icon="@drawable/qa_bookmark"
        android:shortcutShortLabel="@string/qa_favorites"
        android:shortcutLongLabel="@string/qa_favorites">
        <intent
            android:action="android.intent.action.RUN"
            android:targetClass="momra.balady.android.MainActivity"
            android:targetPackage="momra.balady.android">
            <extra
                android:name="some unique action key"
                android:value="favorites" />
        </intent>
    </shortcut>
    <shortcut
        android:shortcutId="directions"
