<?xml version="1.0" encoding="utf-8"?>
<!-- Custom content for the live navigation notification.
     RemoteViews-compatible views only (LinearLayout / TextView / ImageView). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/nav_live_distance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:textAppearance="@android:style/TextAppearance.Material.Notification.Title"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/nav_live_street"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center_horizontal"
            android:singleLine="true"
            android:textAppearance="@android:style/TextAppearance.Material.Notification"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/nav_live_speed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:textAppearance="@android:style/TextAppearance.Material.Notification.Title"
            android:textSize="13sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/nav_live_route_bar"
        android:layout_width="match_parent"
        android:layout_height="24dp"
        android:layout_marginTop="4dp"
        android:contentDescription="@null"
        android:scaleType="fitXY" />
</LinearLayout>